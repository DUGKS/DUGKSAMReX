#############################################
#          if Make.local exist              #
#############################################
ifeq (,$(wildcard $(AMREX_HOME)/Tools/GNUMake/Make.local))
$(error Make.local doesn't exit!!!)
endif

#############################################
#          include basic dependence         #
#############################################
include $(AMREX_HOME)/Tools/GNUMake/Make.defs

#############################################
#       directories in DUGKSAmr/Ark         #
#############################################
Bdirs := Ark
Bdirs += Ark/boundary_conditions
Bdirs += Ark/case
Bdirs += Ark/discrete_velocity_model
Bdirs += Ark/fields
Bdirs += Ark/setup
Bdirs += Ark/utilities

ifeq ($(strip $(USE_EB)),TRUE)
  Bdirs += Ark/embedded_boundary
  USERSuffix += .EB
endif

Bpack += $(foreach dir, $(Bdirs), $(TOP)/$(dir)/Make.package)
Blocs += $(foreach dir, $(Bdirs), $(TOP)/$(dir))

include $(Bpack)
INCLUDE_LOCATIONS += $(Blocs)
VPATH_LOCATIONS   += $(Blocs)

#############################################
#           directories in AMReX            #
#############################################
Pdirs := Base AmrCore Boundary

ifeq ($(USE_EB), TRUE)
  Pdirs += EB
endif

Ppack += $(foreach dir, $(Pdirs), $(AMREX_HOME)/Src/$(dir)/Make.package)
include $(Ppack)

all: $(executable)
	@echo SUCCESS

# job_info support
CEXE_sources += AMReX_buildInfo.cpp
CEXE_headers += $(AMREX_HOME)/Tools/C_scripts/AMReX_buildInfo.H
INCLUDE_LOCATIONS +=  $(AMREX_HOME)/Tools/C_scripts

AMReX_buildInfo.cpp:
	$(AMREX_HOME)/Tools/C_scripts/makebuildinfo_C.py \
          --amrex_home "$(AMREX_HOME)" \
          --COMP "$(COMP)" --COMP_VERSION "$(COMP_VERSION)" \
          --CXX_comp_name "$(CXX)" --CXX_flags "$(CXXFLAGS) $(CPPFLAGS) $(includes)" \
          --F_comp_name "$(F90)" --F_flags "$(F90FLAGS)" \
          --link_flags "$(LDFLAGS)" --libraries "$(libraries)" \
          --GIT "$(TOP) $(AMREX_HOME)"

include $(AMREX_HOME)/Tools/GNUMake/Make.rules

TESTDIR = $(shell pwd)

print:
	$(info $(ARK_USE_MOMENTUM))

DUGKSFILE_LOCATIONS = tmp_build_dir

cleanDUGKS:
	@echo "Cleaning DUGKS Files..."
	find ${DUGKSFILE_LOCATIONS} -name "DUGKS*" -type f -prune -exec rm -f {} \;
	find ${DUGKSFILE_LOCATIONS} -name "main*" -type f -prune -exec rm -f {} \;

cleanOF:
	@echo "Cleaning old plot files..."
	rm -rf ~/.trash/*;
	rm -f AMReX_buildInfo.cpp;
	find ${TESTDIR} -name "chk*" -type d -prune -exec rm -rf {} \;
	find ${TESTDIR} -name "plt*" -type d -prune -exec rm -rf {} \;
	find ${TESTDIR} -name "*.dat" -type f -prune -exec rm -f {} \;
	find ${TESTDIR} -name "*.out" -type f -prune -exec rm -f {} \;
	find ${TESTDIR} -name "*.optrpt" -type f -prune -exec rm -f {} \;
	find ${TESTDIR} -name "Backtrace*" -type f -prune -exec rm -f {} \;
#
#   find ${OUTFILE_LOCATIONS} -name "tecplot-derived" -type d -exec mv -f {} \;
