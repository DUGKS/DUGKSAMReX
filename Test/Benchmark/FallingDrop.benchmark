#¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨#
#              GEOMETRY                 #
#.......................................#
geometry.prob_lo        =  -256   0    -256     # Lo corner coordinates
geometry.prob_hi        =   256   1536  256     # Hi corner coordinates

geometry.is_periodic    =   1 0 1   # Periodicity x y z (0/1)

geometry.ch_num         = 32
geometry.ch_length      = 512.0
geometry.min_length     = 16.0


#¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨#
#        ADAPTIVE MESH REFINEMENT       #
#.......................................#
amr.n_cell              = 32 96 32     # Grid cells at coarsest AMRlevel
amr.max_level           =  4          # Max AMR level in hierarchy 
amr.v                   =   0
amr.regrid_int          =   1
amr.check_input         =   1
amr.blocking_factor     =   8
amr.max_grid_size       =  64
amr.grid_eff            =   0.7
amr.n_error_buf         =   4
#amr.n_proper           =   1           #default set by InitAmrMesh() in AmrMesh.cpp
#amr.ref_ratio          =   2
#amr.refine_grid_layout =   0

#¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨#
#              DUGKSAmr                 #
#.......................................#
DUGKSAmr.verbose         =  10              #
DUGKSAmr.n_ghost         =  2
DUGKSAmr.phi_error       =  
DUGKSAmr.grad_phi_error  =  10 10 10 10 10
DUGKSAmr.tag_region      =  0 
DUGKSAmr.tag_region_lo   =  0 0 0
DUGKSAmr.tag_region_hi   =  0 0 0

#¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨#
#            CASE & SOLVER              #
#.......................................#
case.case_index     =  232          # case index
case.case_name      =  "FallingDrop"  # case name
case.DmVn_name      = "DmVnAC"
case.flux_scheme    = UW
case.scheme_index   = -32
case.solver_name    =   "DUGKSAMReX"            # solver name
case.advance_scheme =   "NEQ"           # momentum model

#¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨#
#         TIME STEP COMPUTATION         #
#.......................................#
time.fixed_trace        =   false       # Use fix time step size in tracing?
time.trace_time_step    =   0.4        # set the tracing time step
time.advance_time_step  =   0.8       # time step size
time.CFL                =   0.8        # Use this constant CFL

#¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨#
#             PHYSICS BASE              #
#.......................................#
base.Rho0 = 1.0
base.U0   = 0.0
base.T0   = 3.33333333333333333E-01
base.R0   = 1.0
base.P0   = 100.0
base.Mu0  = 3.108645431051924e-01
base.Nu0  = 3.108645431051924e-02
base.TauMomentum =  9.325936293155773e-02

#¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨#
#             PHASE FIELD               #
#.......................................#
PF.mobility_phi  =     6.5536e-03
PF.tau_phi       =     1.96608e-02
PF.widthI        =     4.096
PF.sigma         =     9.437184e-05
PF.phiV          =     0
PF.phiL          =     1
PF.rhoV          =     1
PF.rhoL          =     10
PF.muL           =     3.108645431051924e-01
PF.muV           =     4.9152e-02
PF.gravity       =     0.  -1e-07  0.                 # Gravitational force
PF.centerPF      =     0.0  2.5  0.0
PF.radiusPF      =     0.1

#¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨#
#                           BOUNDARY CONDITIONS                          #
#........................................................................#
#¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨#
# INTERIOR 0, INFLOW 1, OUTFLOW 2, SYMMETRY 3, SLIPWALL 4, NONSLIPWALL 5 #
#........................................................................#
#
bc.physical_lo = 0 5 0
bc.physical_hi = 0 5 0
#
#¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨#
# REFLECT_ODD -1, INTERIOR 0, REFLECT_EVEN 1, FOEXTRAP 2, EXTERNAL 3, #
# HOEXTRAP 4, HOEXTRAPCC 5                                            #
#.....................................................................#
bc.phase_lo   = 2 2 2
bc.phase_hi   = 2 2 2

bc.density_lo   = 2 2 2
bc.density_hi   = 2 2 2 

bc.velocity_lo   = 0 2 0
bc.velocity_hi   = 0 2 0

bc.pressure_lo   = 2 2 2
bc.pressure_hi   = 2 2 2

bc.temperature_lo   = 2 2 2
bc.temperature_hi   = 2 2 2

bc.force_lo   = 2 2 2
bc.force_hi   = 2 2 2

bc.DVDF_wave_lo   = 2 2 2
bc.DVDF_wave_hi   = 2 2 2

bc.DVDF_barplus_lo   = 2 2 2
bc.DVDF_barplus_hi   = 2 2 2

bc.dirichlet_velocity_x_lo = 0 0 0 
bc.dirichlet_velocity_x_hi = 0 0 0

bc.dirichlet_velocity_y_lo = 0 0 0 
bc.dirichlet_velocity_y_hi = 0 0 0

bc.dirichlet_velocity_z_lo = 0 0 0 
bc.dirichlet_velocity_z_hi = 0 0 0

bc.dirichlet_phase_lo = 0 0 0
bc.dirichlet_phase_hi = 0 0 0

bc.dirichlet_density_lo = 1 1 1
bc.dirichlet_density_hi = 1 1 1

#bc.dirichlet_pressure_lo = 0 0 0
#bc.dirichlet_pressure_hi = 0 0 0

#¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨#
#            INPUT AND OUTPUT           #
#.......................................#
control.steady_state            = false
control.end_step                =  400000          # Max number of time steps
control.residual_tolerance      =  1E-8           # 
control.adapt_tolerance         =   0.0001
control.plot_file               = "plt"
control.check_file              = "chk"
control.restart_file            = ""        # Checkpoint to restart from
control.conv_interval       =   10000       #norm, sum_density, etc...
control.residual_interval   =   0         
control.plot_interval       =   10000          # Steps between plot files
control.check_interval          = 0            # Steps between checkpoint files
#¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨#
#            PLOT VARIABLES             #
#.......................................#
plot.ccse_regtest    = 1           #0 : default plot 
plot.phi         =   1
plot.rho         =   1
plot.velx        =   1
plot.vely        =   1
plot.velz        =   1
plot.pres        =   1
plot.temp        =   0
plot.gphix       =   1
plot.gphiy       =   1
plot.gphiz       =   1
plot.forcex      =   1
plot.forcey      =   1
plot.forcez      =   1
plot.chemip      =   0
plot.tau         =   0
plot.vort        =   0
plot.strainrate  =   0
plot.divu        =   0
plot.volfrac     =   0
plot.hDVDF       =   0
plot.fDVDF       =   0
plot.gDVDF       =   0