#¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨#
#              GEOMETRY                 #
#.......................................#
geometry.prob_lo        =  -128   0    -128     # Lo corner coordinates
geometry.prob_hi        =   128   1536  128     # Hi corner coordinates

geometry.is_periodic    =   0 0 0   # Periodicity x y z (0/1)

geometry.ch_num         = 256
geometry.ch_length      = 256.0
geometry.min_length     = 1.0


#¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨#
#        ADAPTIVE MESH REFINEMENT       #
#.......................................#
amr.n_cell              = 256 1536 256     # Grid cells at coarsest AMRlevel
amr.max_level           =   0           # Max AMR level in hierarchy 
amr.v                   =	1
amr.regrid_int          =  -1
amr.check_input         =   1
amr.blocking_factor     =   8
amr.max_grid_size       =  64
#amr.grid_eff           =   0.7
#amr.n_error_buf        =   1
#amr.n_proper           =   1           #default set by InitAmrMesh() in AmrMesh.cpp
#amr.ref_ratio          =   2
#amr.refine_grid_layout =   0

#¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨#
#              DUGKSAmr                 #
#.......................................#
DUGKSAmr.verbose         =  1              #
DUGKSAmr.n_ghost		 =  2
DUGKSAmr.phi_error       =   0 0 0
DUGKSAmr.grad_phi_error  =   0 0 0
DUGKSAmr.tag_region      =   0 
DUGKSAmr.tag_region_lo   =   0 0 0
DUGKSAmr.tag_region_hi   =   0 0 0

#¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨#
#            CASE & SOLVER              #
#.......................................#
case.case_index		=  230          # case index
case.case_name      =  "TaylorBubble"  # case name
case.DmVn_name		= "DmVnAC"
case.flux_scheme    = UW
case.scheme_index   = -32
case.solver_name	=	"DVMDUGKSAMReX"			# solver name
case.advance_scheme	=	"CN"			# momentum model

#¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨#
#         TIME STEP COMPUTATION         #
#.......................................#
time.fixed_trace        =   true       # Use fix time step size in tracing?
time.advance_time_step 	=   0.8       # time step size
time.CFL	            =   0.8        # Use this constant CFL
#time.trace_time_step    =   0.4        # set the tracing time step

#¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨#
#             PHYSICS BASE              #
#.......................................#
base.Rho0 = 1.0
base.U0   = 0.0
base.T0   = 3.33333333333333333E-01
base.R0   = 1.0
base.P0   = 100.0
base.Mu0  = 3
base.Nu0  = 0.003
base.TauF = 0.009

#¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨#
#             PHASE FIELD               #
#.......................................#
PF.mobility_phi  =     0.025
PF.tau_phi       =     0.1
PF.widthI        =     8
PF.sigma         =     0.29127
PF.phiV          =     0
PF.phiL          =     1
PF.rhoV          =     1
PF.rhoL          =     1000
PF.muL           =     3
PF.muV           =     0.003
PF.gravity       =     0.  -4.4444444444444444e-07  0.                 # Gravitational force
PF.centerPF      =     0.0  2.4  0.0
PF.radiusPF      =     0.32

#¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨#
#         BOUNDARY CONDITIONS           #
#.......................................#
bc.physical_lo = 5 5 5
bc.physical_hi = 5 5 5

bc.phase_lo   = 2 2 2
bc.phase_hi   = 2 2 2

bc.density_lo   = 2 2 2
bc.density_hi   = 2 2 2 

bc.velocity_lo   = 0 0 0
bc.velocity_hi   = 0 0 0

bc.pressure_lo   = 2 2 2
bc.pressure_hi   = 2 2 2

bc.temperature_lo   = 2 2 2
bc.temperature_hi   = 2 2 2

bc.force_lo   = 2 2 2
bc.force_hi   = 2 2 2

bc.DVDF_wave_lo   = 2 2 2
bc.DVDF_wave_hi   = 2 2 2

bc.DVDF_barplus_lo   = 2 2 2
bc.DVDF_barplus_hi   = 2 2 2

bc.dirichlet_velocity_x_lo = 0 0 0 
bc.dirichlet_velocity_x_hi = 0 0 0

bc.dirichlet_velocity_y_lo = 0 0 0 
bc.dirichlet_velocity_y_hi = 0 0 0

bc.dirichlet_velocity_z_lo = 0 0 0 
bc.dirichlet_velocity_z_hi = 0 0 0

#bc.dirichlet_pressure_lo = 0 0 0
#bc.dirichlet_pressure_hi = 0 0 0

#¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨#
#            INPUT AND OUTPUT           #
#.......................................#
control.steady_state            = false
control.end_step                =  300000          # Max number of time steps
control.residual_tolerance      =  1E-8           # 
control.adapt_tolerance			=	0.0001
control.plot_file               = "plt"
control.check_file              = "chk"
control.check_interval    	    = 150000            # Steps between checkpoint files
control.restart_file            = ""        # Checkpoint to restart from
control.conv_interval	    =	10000		#norm, sum_density, etc...
control.residual_interval   = 	0         
control.plot_interval		=	10000          # Steps between plot files
control.plt_ccse_regtest    = 1           #0 : default plot 